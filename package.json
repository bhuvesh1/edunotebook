{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "SWC_NATIVE_BINDING_CACHE=/tmp/swc-cache next dev",
    "build": "SWC_NATIVE_BINDING_CACHE=/tmp/swc-cache next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "PRISMA_SCHEMA_ENGINE_BINARY=./node_modules/@prisma/engines/schema-engine-debian-openssl-3.0.x PRISMA_QUERY_ENGINE_LIBRARY=./node_modules/.prisma/client/libquery_engine-debian-openssl-3.0.x.so.node prisma db push",
    "db:seed": "PRISMA_QUERY_ENGINE_LIBRARY=./node_modules/.prisma/client/libquery_engine-debian-openssl-3.0.x.so.node prisma db seed",
    "db:seed:blogs": "PRISMA_QUERY_ENGINE_LIBRARY=./node_modules/.prisma/client/libquery_engine-debian-openssl-3.0.x.so.node tsx prisma/seed-blogs.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@types/adm-zip": "^0.5.8",
    "@types/three": "^0.186.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "cannon-es": "^0.20.0",
    "next": "16.3.7",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
